import numpy as np
import pandas as pd

tensor    = np.load('demand_tensor.npy')   # (N, T, 2, 2)
stations  = np.load('stations.npy', allow_pickle=True)
time_bins = np.load('time_bins.npy', allow_pickle=True)

# ========== 1. 按总需求排序，取前 K 个站点 ==========
total_demand = tensor.sum(axis=(1,2,3))   # 每个站点的总借还量
top_k = 300
top_ids = np.argsort(total_demand)[-top_k:]
tensor_filtered = tensor[top_ids]          # (300, T, 2, 2)
stations_filtered = stations[top_ids]
print(f"保留 {top_k} 个站点")

# ========== 2. 构建特征和目标 ==========
# 通道设计：0,1 -> 自行车借/还；2,3 -> 电动车借/还
features = np.concatenate([tensor_filtered[:,:,0,:], tensor_filtered[:,:,1,:]], axis=-1)
# 形状: (300, T, 4)

# ========== 3. 标准化（过每个站点） ==========
mean = features.mean(axis=(1,2), keepdims=True)
std  = features.std(axis=(1,2), keepdims=True) + 1e-5
features_norm = (features - mean) / std

# ========== 4. 时间滑动窗口 ==========
def create_sequences(data, input_len=12, output_len=1):
    """返回 X: (样本数, 站点, 输入步, 特征), Y: (样本数, 站点, 输出步, 特征)"""
    X, Y = [], []
    for t in range(data.shape[1] - input_len - output_len + 1):
        X.append(data[:, t:t+input_len, :])
        Y.append(data[:, t+input_len:t+input_len+output_len, :])
    return np.array(X), np.array(Y)

X_all, Y_all = create_sequences(features_norm, input_len=12, output_len=1)
print(f"输入形状: {X_all.shape}, 目标形状: {Y_all.shape}")

# ========== 5. 时序切分（避免泄露） ==========
T_total = X_all.shape[0]
train_end = int(T_total * 0.7)
val_end   = int(T_total * 0.85)

X_train, Y_train = X_all[:train_end], Y_all[:train_end]
X_val,   Y_val   = X_all[train_end:val_end], Y_all[train_end:val_end]
X_test,  Y_test  = X_all[val_end:], Y_all[val_end:]
print(f"训练集: {X_train.shape}, 验证集: {X_val.shape}, 测试集: {X_test.shape}")

# 保存
np.savez('pred_data.npz',
         X_train=X_train, Y_train=Y_train,
         X_val=X_val, Y_val=Y_val,
         X_test=X_test, Y_test=Y_test,
         mean=mean, std=std,
         stations=stations_filtered)
print("预测数据已保存至 pred_data.npz")
