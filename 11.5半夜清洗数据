    df_clean_all.to_csv(OUTPUT_CLEAN_FILE, index=False)
    print(f"清洗后行程数据已保存至 {OUTPUT_CLEAN_FILE}")
    import os

    for temp_f in temp_files:
        try:
            os.remove(temp_f)
        except:
            pass
    print("临时文件已清理。")


